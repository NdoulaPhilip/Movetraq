NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_PROVIDER=paystack
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL=https://example.com/payments/return
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_GEOCODING_API_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
JWT_AUDIENCE=authenticated
LOG_LEVEL=info
AUTH_REDIRECT_URL=movetraq://auth/callback
ADMIN_INVITE_REDIRECT_URL=http://localhost:5173/accept-invitation
MOBILE_MONITORING_URL=https://movetraq-api.onrender.com
# Set the same random server-only value on both APIs; never on the admin site.
MONITORING_SERVICE_TOKEN=

# OSM defaults: public endpoints for light evaluation; configure hosted services for scale.
MAPS_PROVIDER=osm
GEOCODER_PROVIDER=photon
PHOTON_URL=https://photon.komoot.io
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
MAPS_USER_AGENT=MoveTraq/1.0 (https://github.com/NdoulaPhilip/Movetraq)
